# Database
DATABASE_URL=postgresql://outage:outage_dev@localhost:5432/outagelens

# Retrieval
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_WORDS=220
CHUNK_OVERLAP=40
CANDIDATES=40
RRF_K=60

# LLM: none | ollama | anthropic
# "none" still works: answers are assembled from the extracted fields.
LLM_PROVIDER=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
